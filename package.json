{
  "name": "atomberg-iot-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Atomberg public developer API",
  "type": "module",
  "bin": {
    "atomberg-iot-mcp": "plugins/atomberg-iot/dist/index.js"
  },
  "files": [
    "plugins/atomberg-iot/dist"
  ],
  "scripts": {
    "build": "tsc && esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --minify --outfile=plugins/atomberg-iot/dist/index.js",
    "start": "node plugins/atomberg-iot/dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node --env-file-if-exists=.env plugins/atomberg-iot/dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
